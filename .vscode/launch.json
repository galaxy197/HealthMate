{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HealthMate App (Flutter)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "debug"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "HealthMate Admin (localhost:4173)",
            "preLaunchTask": "HealthMate: start admin local",
            "url": "http://127.0.0.1:4173",
            "webRoot": "${workspaceFolder}/admin-web/dist"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "HealthMate Admin (online)",
            "url": "https://healthmate-admin-vn.web.app",
            "webRoot": "${workspaceFolder}/admin-web/dist"
        }
    ]
}
